# WalletConnect Cloud project id (required by RainbowKit) - https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# The Factory contract (SmartContract.sol, extends DataStorage + WindowFactory) that
# deploys/tracks round windows and holds per-user registration data. Used directly for
# registration-status and package-limit reads (userAddrExists, addrToId, getUserData,
# getUserPeriodEarnable, entranceCap) via /contracts/factoryAbi.ts.
#
# This is the redesigned version (stage 1-4 pool controller + weekly $500-matching
# window + the geometric-decay payout floor) - not the same deployment as before.
#
# This factory migrated from the previous deployment (0xFe3D2Bbd15a5c2f860d5d03811bAb5f7B068875C,
# which ran 50 rounds) - see SmartContract.sol's constructor/init().
NEXT_PUBLIC_FACTORY_ADDRESS=0x4c7c8060580b6b5Eb50dA04Ad06Fb26B4E7159C3

# The current/latest Window (round) contract - this is the contract the whole app
# reads from and writes to using the ABI in /contracts/roundWindowAbi.ts. Only used
# as a first-paint fallback; useLatestRoundWindow() always resolves the live one.
NEXT_PUBLIC_WINDOW_ADDRESS=0x12F43550819f6D7e9D9f180d77059d760b9ef9c9

# The current/latest WeeklyWindow contract - collects the $500-matching bonus pool
# for the week in progress. Only used as a first-paint fallback; useLatestWeeklyWindow()
# always resolves the live one via factory.weeklyWindow().
NEXT_PUBLIC_WEEKLY_WINDOW_ADDRESS=0x5A375cF2888eDda9D198caD8E8DAf01a613275a5

# Chain id the contracts above are deployed on. Defaults to BNB Smart Chain (56).
NEXT_PUBLIC_CHAIN_ID=56

# Optional: RPC override for the primary chain (falls back to a public RPC otherwise)
NEXT_PUBLIC_RPC_URL=

# Client-side gate for the /admin panel. The provided ABI has no on-chain owner()
# getter, so this is a UX convenience only - it hides the admin UI for everyone
# except this address. It is NOT a security boundary: the contract itself is the
# real authority and will revert admin-only calls from unauthorized callers.
NEXT_PUBLIC_ADMIN_ADDRESS=

# Optional: block explorer base url override (auto-detected from chain otherwise)
NEXT_PUBLIC_EXPLORER_URL=

# Optional: public site URL used to build sitemap.xml entries
NEXT_PUBLIC_SITE_URL=

# Optional: BscScan/Etherscan API key. The contract ABI has no events, so
# without this key the Dashboard's Activity panel only shows transactions
# submitted from this browser. With it (and NEXT_PUBLIC_CHAIN_ID=56), it also
# shows the connected wallet's real on-chain history with the window contract,
# and enables the Dashboard's Live Network Activity feed (real registrations/
# top-ups from any wallet, decoded from the explorer's txlist for the active
# window contract).
#
# BscScan's old v1 endpoint (api.bscscan.com/api) is deprecated - this app
# calls Etherscan's unified v2 gateway instead (api.etherscan.io/v2/api,
# chainid=56 for BSC). Get a key at https://etherscan.io/apis. IMPORTANT: as
# of this writing, Etherscan's free tier does not include BSC data access -
# a "Free API access is not supported for this chain" response means the key
# itself is fine but needs a paid plan for BSC coverage. Check your plan at
# https://etherscan.io/apis if the Live Network Activity feed stays empty
# with a key configured.
NEXT_PUBLIC_BSCSCAN_API_KEY=

# Optional: On-Chain Backgammon (app/games/backgammon-onchain) - contracts
# (BSC Testnet), API, and WebSocket for the separately-deployed backend
# (github.com/Rezamoradifar/backgammon-). All four default to the current
# live BSC Testnet deployment (see contracts/onchainBackgammon/addresses.ts) -
# only set these if that deployment is ever replaced.
NEXT_PUBLIC_ONCHAIN_GAME_MANAGER_ADDRESS=
NEXT_PUBLIC_ONCHAIN_PLAYER_REGISTRY_ADDRESS=
NEXT_PUBLIC_ONCHAIN_API_URL=
NEXT_PUBLIC_ONCHAIN_WS_URL=

# NodeShield VPN product (app/products/vpn, /api/vpn/*, /api/admin/vpn/*).
# Flat per-device pricing - $1/device/month, unlimited, paid in USDT or BNB.
# Payment side (public - a payer needs to know these):
NEXT_PUBLIC_VPN_PAYMENT_ADDRESS=
NEXT_PUBLIC_VPN_PRICE_PER_DEVICE_USD=1
#
# VPN server side (server-only secrets - never NEXT_PUBLIC_). Leave unset and
# the product page shows "not live yet" instead of a payment flow; the admin
# panel's Provision button reports "not configured" instead of pretending to
# succeed. See scripts/vpn/setup-server.sh and scripts/vpn/add-peer.sh for
# what needs to be installed on the VPN server itself before setting these.
VPN_SERVER_HOST=
VPN_SERVER_SSH_PORT=22
VPN_SERVER_SSH_USER=
VPN_SERVER_SSH_KEY_PATH=

# Full-site maintenance lockdown (see middleware.ts + app/maintenance/page.tsx).
# Defaults to OFF (only the literal string "true" turns it on) - leave unset
# for normal operation. Set to "true" and redeploy to lock every route except
# /maintenance and /api/feedback behind the maintenance/feedback page again,
# e.g. while preparing the next contract migration.
MAINTENANCE_MODE=false
